[Unit]
Description=webcrawl HTTP API + WebUI
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail) — never start before the project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/github_repos/webcrawl
EnvironmentFile=/home/ubuntu/github_repos/webcrawl/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
