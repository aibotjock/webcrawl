{
  "name": "webcrawl",
  "version": "0.2.0",
  "description": "Free self-hosted search and crawl: Exa-compatible search with Jev ranking, plus scrape/crawl/map/extract, HTTP API, MCP server and WebUI",
  "type": "module",
  "bin": {
    "webcrawl": "src/server.js",
    "webcrawl-mcp": "src/mcp.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "mcp": "node --env-file-if-exists=.env src/mcp.js",
    "test": "node --test 'test/unit/*.test.js'",
    "bench": "node scripts/bench.js",
    "capture:bar": "node scripts/bar-capture.js",
    "test:live": "node --test test/scrape.test.js",
    "bench:search": "node scripts/bench-search.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "turndown": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/search/engine.js",
    "./server": "./src/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "webui",
    "README.md",
    "notes"
  ],
  "keywords": [
    "search",
    "exa",
    "crawler",
    "scraper",
    "mcp",
    "jev",
    "firecrawl"
  ]
}
