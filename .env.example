# Copy to .env (local) or paste into your host's variables (Railway etc.) when ready.
# Everything is optional: with nothing set, webcrawl searches with keyless sources
# (DuckDuckGo, Wikipedia) and ranks with BM25.

# --- Server ---
PORT=8787
# Required before exposing the server publicly (clients send x-api-key or Bearer):
WEBCRAWL_API_KEY=

# --- Jev ranking (TypeSafe) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# Photo search and screenshot ranking (experimental TypeSafe image input):
WEBCRAWL_JEV_IMAGES=off

# --- Any LLM, for deep search, answers, summaries, extract ---
# openai = any OpenAI-compatible server (LM Studio, Ollama, vLLM, OpenAI, OpenRouter, Groq...)
WEBCRAWL_LLM_PROVIDER=openai
WEBCRAWL_LLM_BASE_URL=http://127.0.0.1:1234/v1
WEBCRAWL_LLM_MODEL=
WEBCRAWL_LLM_API_KEY=

# --- Optional embeddings (OpenAI-compatible /embeddings) ---
WEBCRAWL_EMBED_BASE_URL=
WEBCRAWL_EMBED_MODEL=
WEBCRAWL_EMBED_API_KEY=

# --- Extra search sources ---
SEARXNG_URL=
BRAVE_API_KEY=
EXA_API_KEY=
# Restrict sources, e.g. searxng,brave,wikipedia
WEBCRAWL_SEARCH_PROVIDERS=

# --- Cache ---
WEBCRAWL_CACHE_DIR=.cache/pages
WEBCRAWL_CACHE_MAX=5000

# Local development only: allow crawling localhost / private network addresses
WEBCRAWL_ALLOW_PRIVATE=off
