# webcrawl configuration — copy to .env and edit. All values are optional.

# HTTP API + WebUI port
PORT=8787

# --- AI model that powers /extract and the WebUI "Model" panel ---
# You can also change these live from the WebUI (they seed the initial state here).
#
# provider id: lmstudio | ollama | llamacpp | openai | anthropic | cloud
WEBCRAWL_LLM_PROVIDER=lmstudio
# OpenAI-compatible base URL (must end in /v1)
WEBCRAWL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# model id served by that endpoint
WEBCRAWL_LLM_MODEL=local-model
# Bearer key for CLOUD providers only (leave blank for local Ollama/LM Studio/llama.cpp)
WEBCRAWL_LLM_API_KEY=

# --- Local model examples ---
# Ollama:     WEBCRAWL_LLM_PROVIDER=ollama   WEBCRAWL_LLM_BASE_URL=http://127.0.0.1:11434/v1  WEBCRAWL_LLM_MODEL=llama3.1
# LM Studio:  WEBCRAWL_LLM_PROVIDER=lmstudio WEBCRAWL_LLM_BASE_URL=http://127.0.0.1:1234/v1   WEBCRAWL_LLM_MODEL=<loaded-model>
# llama.cpp:  WEBCRAWL_LLM_PROVIDER=llamacpp WEBCRAWL_LLM_BASE_URL=http://127.0.0.1:8080/v1   WEBCRAWL_LLM_MODEL=<model>

# --- Cloud model examples (OpenAI-compatible) ---
# OpenAI:     WEBCRAWL_LLM_PROVIDER=openai   WEBCRAWL_LLM_BASE_URL=https://api.openai.com/v1  WEBCRAWL_LLM_MODEL=gpt-4o-mini  WEBCRAWL_LLM_API_KEY=sk-...
# Any gateway:WEBCRAWL_LLM_PROVIDER=cloud    WEBCRAWL_LLM_BASE_URL=https://your-endpoint/v1   WEBCRAWL_LLM_MODEL=<model>     WEBCRAWL_LLM_API_KEY=<key>

# --- Anthropic Claude (native /v1/messages API, NOT OpenAI-compatible) ---
# Claude:     WEBCRAWL_LLM_PROVIDER=anthropic WEBCRAWL_LLM_BASE_URL=https://api.anthropic.com/v1 WEBCRAWL_LLM_MODEL=claude-3-5-sonnet-latest
# The key can go in WEBCRAWL_LLM_API_KEY (sent as x-api-key) or in ANTHROPIC_API_KEY below.
ANTHROPIC_API_KEY=
# anthropic-version header sent with every request (default 2023-06-01)
# WEBCRAWL_ANTHROPIC_VERSION=2023-06-01

# --- crawl/map tuning ---
WEBCRAWL_CONCURRENCY=8
WEBCRAWL_TIMEOUT_MS=30000
# WEBCRAWL_UA=<custom user agent>
