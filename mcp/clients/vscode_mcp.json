{
  "// note": "VS Code native MCP (Copilot Agent mode). Save as .vscode/mcp.json in your workspace, or add under \"mcp.servers\" in user settings.json.",
  "servers": {
    "webcrawl": {
      "type": "stdio",
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/webcrawl/src/mcp.js"],
