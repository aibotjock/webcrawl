{
  "// note": "Add this block to ~/.continue/config.json under an \"experimental.modelContextProtocolServers\" array (Continue for VS Code / JetBrains).",
  "experimental": {
    "modelContextProtocolServers": [
      {
        "transport": {
          "type": "stdio",
          "command": "node",
          "args": ["/ABSOLUTE/PATH/TO/webcrawl/src/mcp.js"],
          "env": {
            "WEBCRAWL_LLM_PROVIDER": "anthropic",
            "WEBCRAWL_LLM_BASE_URL": "https://api.anthropic.com/v1",
            "WEBCRAWL_LLM_MODEL": "claude-3-5-sonnet-latest",
            "ANTHROPIC_API_KEY": "sk-ant-..."
          }
        }
      }
    ]
  }
}
